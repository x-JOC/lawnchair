<!-- Frequent / Recent / New or updated apps, drawn over the app drawer's lists right under the
     search bar while the search box is in use (ActivityAllAppsContainerView adds it). Stays gone
     outside the launcher's own drawer (taskbar, secondary displays). -->
<app.lawnchair.allapps.suggestions.AppSuggestionsHeaderView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_suggestions_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingBottom="@dimen/drawer_suggestions_panel_padding_bottom"
    android:visibility="gone">

    <app.lawnchair.allapps.suggestions.SuggestionTabBar
        android:id="@+id/suggestion_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:orientation="horizontal">

        <!-- Same order as SuggestionTab.entries. RTL mirrors it. -->
        <TextView
            android:id="@+id/suggestion_tab_frequent"
            style="@style/DrawerSuggestionTab"
            android:text="@string/drawer_suggestions_tab_frequent" />

        <TextView
            android:id="@+id/suggestion_tab_recent"
            style="@style/DrawerSuggestionTab"
            android:text="@string/drawer_suggestions_tab_recent" />

        <TextView
            android:id="@+id/suggestion_tab_new"
            style="@style/DrawerSuggestionTab"
            android:text="@string/drawer_suggestions_tab_new" />
    </app.lawnchair.allapps.suggestions.SuggestionTabBar>

    <!-- Fills the rest of the panel, which is measured to exactly the rows it needs. -->
    <FrameLayout
        android:id="@+id/suggestion_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <app.lawnchair.allapps.suggestions.SuggestionIconGrid
            android:id="@+id/suggestion_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/suggestion_empty"
            style="@style/DrawerSuggestionEmptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</app.lawnchair.allapps.suggestions.AppSuggestionsHeaderView>
