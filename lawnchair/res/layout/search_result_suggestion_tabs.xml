<?xml version="1.0" encoding="utf-8"?>
<app.lawnchair.allapps.views.SearchResultSuggestionTabs xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_result_suggestion_tabs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/tabs_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="false">

        <TextView
            android:id="@+id/tab_frequent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/search_suggested_frequent_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tab_recent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/search_suggested_recent_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tab_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="@string/search_suggested_new_title"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/usage_access_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="10dp"
        android:text="@string/search_suggested_usage_access_prompt"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:visibility="gone" />

</app.lawnchair.allapps.views.SearchResultSuggestionTabs>
