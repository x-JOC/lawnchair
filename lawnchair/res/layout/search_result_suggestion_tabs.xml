<?xml version="1.0" encoding="utf-8"?>
<!-- The tabs reuse the app drawer's Personal/Work tab strip (all_apps_personal_work_tabs.xml):
     same view class, pill drawable, colors and text style. The row is inset to the icon columns in
     code (like the strip's alignOnIcon) and ends with the search settings button, which replaces
     the separate settings row below the results while the tabs are shown. -->
<app.lawnchair.allapps.views.SearchResultSuggestionTabs xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_result_suggestion_tabs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:orientation="vertical"
    android:paddingBottom="@dimen/all_apps_header_bottom_padding">

    <LinearLayout
        android:id="@+id/tabs_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_apps_header_pill_height"
        android:layout_marginTop="@dimen/all_apps_tabs_margin_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.android.launcher3.workprofile.PersonalWorkSlidingTabStrip
            android:id="@+id/tabs_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:importantForAccessibility="yes"
            android:orientation="horizontal"
            style="@style/TextHeadline"
            launcher:alignOnIcon="false">

            <Button
                android:id="@+id/tab_frequent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/all_apps_tabs_button_horizontal_padding"
                android:layout_weight="1"
                android:background="@drawable/all_apps_tabs_background"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/search_suggested_frequent_title"
                android:textColor="@color/all_apps_tab_text"
                android:textSize="14sp"
                style="@style/AllAppsPersonalWorkTabStyle" />

            <Button
                android:id="@+id/tab_recent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/all_apps_tabs_button_horizontal_padding"
                android:layout_marginEnd="@dimen/all_apps_tabs_button_horizontal_padding"
                android:layout_weight="1"
                android:background="@drawable/all_apps_tabs_background"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/search_suggested_recent_title"
                android:textColor="@color/all_apps_tab_text"
                android:textSize="14sp"
                style="@style/AllAppsPersonalWorkTabStyle" />

            <Button
                android:id="@+id/tab_new"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/all_apps_tabs_button_horizontal_padding"
                android:layout_weight="1"
                android:background="@drawable/all_apps_tabs_background"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/search_suggested_new_title"
                android:textColor="@color/all_apps_tab_text"
                android:textSize="14sp"
                style="@style/AllAppsPersonalWorkTabStyle" />
        </com.android.launcher3.workprofile.PersonalWorkSlidingTabStrip>

        <ImageButton
            android:id="@+id/search_settings"
            android:layout_width="@dimen/all_apps_header_pill_height"
            android:layout_height="@dimen/all_apps_header_pill_height"
            android:layout_marginStart="@dimen/all_apps_tabs_button_horizontal_padding"
            android:background="@drawable/pill_ripple"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_setting" />

    </LinearLayout>

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

</app.lawnchair.allapps.views.SearchResultSuggestionTabs>
